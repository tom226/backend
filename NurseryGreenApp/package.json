{
  "name": "nursery-green-app",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "volta": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "export:web:node24": "npx -y node@24 ./node_modules/expo/bin/cli export --platform web",
    "build:android:production": "npx -y node@24 ./node_modules/eas-cli/bin/run build --platform android --profile production",
    "build:android:production:ci": "npx -y node@24 ./node_modules/eas-cli/bin/run build --platform android --profile production --non-interactive",
    "update:preview": "eas update --channel preview --message \"Preview OTA update\"",
    "update:production": "eas update --channel production --message \"Production OTA update\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~52.0.0",
    "expo-application": "~6.0.2",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.5",
    "expo-notifications": "^0.29.14",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "^0.26.19",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "^0.76.9",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "eas-cli": "^18.1.0"
  },
  "private": true
}
